# ---------------------------------------------------------------------------
# ORYA API — modèle de configuration
# Copier ce fichier vers .env puis remplacer CHAQUE valeur "CHANGEME".
# Le fichier .env ne doit jamais être commité (voir .gitignore).
# ---------------------------------------------------------------------------

# Rôle applicatif : soumis au Row Level Security (NOBYPASSRLS).
DATABASE_URL="postgresql://orya_app:CHANGEME@localhost:5432/orya?schema=public&connection_limit=10"

# Rôle propriétaire : migrations, policies RLS, seed (BYPASSRLS).
# N'est jamais utilisé par l'API en exécution.
DIRECT_DATABASE_URL="postgresql://orya_owner:CHANGEME@localhost:5432/orya?schema=public"

# Serveur
NODE_ENV=development
API_PORT=3200
CORS_ORIGINS="http://localhost:3000"

# Jeton d'accès (32 caractères minimum, généré aléatoirement)
JWT_ACCESS_SECRET="CHANGEME-32-caracteres-minimum-aleatoires"
JWT_ACCESS_TTL="15m"
# CDC 3.4 : deconnexion des sessions inactives (minutes). Web / sans plateforme ; mobiles (android, ios).
SESSION_IDLE_MINUTES="30"
SESSION_IDLE_MOBILE_MINUTES="43200"

# Argon2id — paramètres de référence OWASP (à ajuster selon la machine)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Clé de chiffrement des secrets TOTP (AES-256-GCM), 32 octets en base64.
# Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY="CHANGEME-32-octets-en-base64"

# Mot de passe des comptes de démonstration créés par prisma/seed.ts.
# Usage local uniquement. Le seed refuse de tourner en production.
SEED_PASSWORD="CHANGEME-mot-de-passe-de-demonstration"

# Import Excel/CSV (Lot 2.1) — optionnel
# IMPORT_MAX_BYTES=5000000
# IMPORT_MAX_ROWS=5000
# IMPORT_RATE_LIMIT=20
# Limite globale de requetes par minute et par IP (defaut 120).
# API_RATE_LIMIT=120

# Lot 4 : stockage privé des justificatifs (jamais servi en direct, flux API uniquement).
# local = dossier privé hors racine web (chemin absolu, hors dépôt) ; s3 = non implémenté.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=C:\orya-private-storage
UPLOAD_MAX_BYTES=5000000
UPLOAD_RATE_LIMIT=20

# Lot 8 : exports compatibles saisie Massar (hypotheses a verifier avec une ecole)
# MASSAR_CODE_PATTERN=^[A-Z][0-9]{9}$
# MASSAR_COLUMN_LABELS={"massarCode":"Code Massar"}

# Lot 10 : session web (cookies httpOnly SameSite=Strict + CSRF double soumission)
# COOKIE_SECURE=true          # force Secure (defaut : true si NODE_ENV=production)
# COOKIE_DOMAIN=.orya.ma      # si web et API sont sur des sous-domaines distincts
# ACCESS_COOKIE_MAX_AGE_S=900
# REFRESH_COOKIE_MAX_AGE_S=2592000

# Bloc 5 facturation ecole : identite legale ORYA. VALEURS FICTIVES ; en production, l'emission est refusee tant qu'une valeur contient FICTIF.
BILLING_ISSUER_NAME=ORYA SARL (EXEMPLE FICTIF)
BILLING_ISSUER_ADDRESS=1 rue Exemple, 10000 Rabat (ADRESSE FICTIVE)
BILLING_ISSUER_ICE=ICE-FICTIF-000000000000000
BILLING_ISSUER_IF=IF-FICTIF-00000000
BILLING_ISSUER_RC=RC-FICTIF-00000
BILLING_ISSUER_RIB=RIB-FICTIF-000-000-0000000000000000-00
BILLING_ISSUER_BANK=BANQUE FICTIVE
# SCHOOL_BILLING_JOB_MS=21600000
# SCHOOL_BILLING_JOB_DISABLED=0
# F01 (t87u) mot de passe oublie : boite d'envoi locale en dev/test (un fichier JSON par message,
# jamais en production). Lien = WEB_ORIGIN + /nouveau-mot-de-passe#token=...
# MAIL_OUTBOX_DIR=tmp/orya-mail-outbox
# WEB_ORIGIN=http://localhost:3000
# PASSWORD_RESET_TTL_MINUTES=30

# t92 (CDC M3) : rappel « appel non fait » a 7h45 (heure de l'ecole), notification in-app.
ATTENDANCE_REMINDER_JOB_DISABLED=0
ATTENDANCE_REMINDER_JOB_MS=300000

# t92 (CDC M7) : resume hebdomadaire aux familles (vendredi a partir de 16h, heure de l'ecole).
WEEKLY_SUMMARY_JOB_DISABLED=0
WEEKLY_SUMMARY_JOB_MS=900000
