# ORYA web (Next.js) — image de production (préparation lot 10, non déployée).
# NEXT_PUBLIC_API_BASE est figé au build : le passer en --build-arg.
FROM node:22-bookworm-slim AS build
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --include=dev
COPY apps/web/ ./
RUN npx next build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
RUN groupadd -r orya && useradd -r -g orya orya
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
# P0-7 : copie elaguee - ni sources app/ lib/, ni .env.example, ni cache de build.
COPY --from=build --chown=orya:orya /app/package.json /app/next.config.ts ./
COPY --from=build --chown=orya:orya /app/node_modules ./node_modules
COPY --from=build --chown=orya:orya /app/.next ./.next
RUN rm -rf .next/cache
USER orya
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
