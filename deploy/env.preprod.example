# ORYA - variables de PRE-PRODUCTION (EXEMPLE ; copier en deploy/.env.preprod sur le serveur,
# jamais commite). Valeurs = emplacements a remplir ; AUCUNE valeur reelle ici.
# Chaque secret est genere SUR le serveur (ou dans le coffre) et n'est jamais reutilise en
# production. Runbook : docs/preproduction.md.
NODE_ENV=production
API_PORT=3200
CORS_ORIGINS=https://app.preprod.example.ma
PUBLIC_API_BASE=https://api.preprod.example.ma/api/v1
COOKIE_SECURE=true
COOKIE_DOMAIN=.preprod.example.ma
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=__a_generer_48_octets_hex__
MFA_ENCRYPTION_KEY=__a_generer_32_octets_base64__
POSTGRES_ADMIN_USER=__a_definir__
POSTGRES_ADMIN_PASSWORD=__a_generer__
ORYA_APP_PASSWORD=__a_generer__
API_RATE_LIMIT=300
AUTH_LOGIN_LIMIT=5
# F01 (t87u) mot de passe oublie : plafonds (defauts), duree du lien en minutes (5-60).
# Aucun fournisseur e-mail de production n'est branche : la demande repond 503 (refus ferme) tant
# qu'il n'est pas choisi. WEB_ORIGIN = origine publique de la console (lien envoye par e-mail).
PASSWORD_RESET_IP_LIMIT=5
PASSWORD_RESET_ACCOUNT_LIMIT=3
PASSWORD_RESET_CONFIRM_IP_LIMIT=10
PASSWORD_RESET_TTL_MINUTES=30
UPLOAD_MAX_BYTES=5242880

# Stockage des fichiers : bucket S3 PRIVE de pre-production (Block Public Access, chiffrement
# par defaut), identifiants limites a ce bucket. Verifier avec scripts/test-s3-provider.ps1.
STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=__bucket_fichiers_preprod__
STORAGE_S3_REGION=__region__
# STORAGE_S3_ENDPOINT=https://__endpoint_hors_aws__
# STORAGE_S3_FORCE_PATH_STYLE=1
STORAGE_S3_ACCESS_KEY_ID=__identifiant_fichiers__
STORAGE_S3_SECRET_ACCESS_KEY=__secret_fichiers__
STORAGE_S3_SSE=AES256
STORAGE_PRESIGN_SECONDS=120

# Registre des suppressions : cle HMAC hors base (coffre), jamais celle de la production.
DELETION_REGISTER_HMAC_KEY=__a_generer_32_octets_base64__
# DELETION_REGISTER_JOURNAL est fixe par la composition (volume "journal").

# Journal WORM (t62u B3) : bucket DEDIE cree avec Object Lock, retention par defaut COMPLIANCE.
# L'API ne recoit QUE les identifiants d'ECRITURE SEULE (PutObject sur le prefixe), distincts
# de STORAGE_S3_* ; les identifiants de LECTURE (rejeu apres restauration) restent chez
# l'exploitant et ne sont JAMAIS mis dans ce fichier.
DELETION_JOURNAL_WORM_BUCKET=__bucket_journal_worm_preprod__
DELETION_JOURNAL_WORM_REGION=__region__
# DELETION_JOURNAL_WORM_ENDPOINT=https://__endpoint_hors_aws__
# DELETION_JOURNAL_WORM_FORCE_PATH_STYLE=1
DELETION_JOURNAL_WORM_PREFIX=deletion-journal/v1/
DELETION_JOURNAL_WORM_WRITER_ACCESS_KEY_ID=__identifiant_ecriture_seule__
DELETION_JOURNAL_WORM_WRITER_SECRET_ACCESS_KEY=__secret_ecriture_seule__

# Facturation ecole : BILLING_ISSUER_* (NAME, ADDRESS, ICE, IF, RC, RIB, BANK) volontairement
# ABSENTES. Avec NODE_ENV=production, l'emission de facture est alors REFUSEE (valeurs fictives
# par defaut) : comportement attendu en pre-production. [DECISION] Ayoub : renseigner
# l'identite legale reelle seulement pour la recette comptable, jamais de valeur inventee.
