# ORYA — variables de production (EXEMPLE ; copier en deploy/.env.prod, jamais commité).
NODE_ENV=production
API_PORT=3200
CORS_ORIGINS=https://app.example.ma
PUBLIC_API_BASE=https://api.example.ma/api/v1
COOKIE_SECURE=true
COOKIE_DOMAIN=.example.ma
JWT_ACCESS_SECRET=__a_generer_48_octets_hex__
MFA_ENCRYPTION_KEY=__a_generer_32_octets_base64__
POSTGRES_ADMIN_USER=__a_definir__
POSTGRES_ADMIN_PASSWORD=__a_definir__
ORYA_APP_PASSWORD=__a_definir__
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/lib/orya/storage
UPLOAD_MAX_BYTES=5242880
API_RATE_LIMIT=300
AUTH_LOGIN_LIMIT=5
# F01 (t87u) mot de passe oublie : plafonds (defauts), duree du lien en minutes (5-60).
# Aucun fournisseur e-mail de production n'est branche : la demande repond 503 (refus ferme) tant
# qu'il n'est pas choisi. WEB_ORIGIN = origine publique de la console (lien envoye par e-mail).
PASSWORD_RESET_IP_LIMIT=5
PASSWORD_RESET_ACCOUNT_LIMIT=3
PASSWORD_RESET_CONFIRM_IP_LIMIT=10
PASSWORD_RESET_TTL_MINUTES=30
# MASSAR_CODE_PATTERN / MASSAR_COLUMN_LABELS : voir docs/lot8-massar-exports.md

# P0-4 : nombre exact de proxys de confiance devant l'API (1 = un reverse proxy TLS unique ; 0 = exposition directe).
TRUST_PROXY_HOPS=1
